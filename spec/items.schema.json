{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokkiri.night/onboarding-kit/items.schema.json",
  "title": "ポッキリ.Night 初期設定キット 項目定義",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "form",
    "sections",
    "themes",
    "chapters",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "desc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[1-9][0-9]?$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "sheet",
          "photo_ok"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "photo_ok": {
            "type": "boolean"
          },
          "sheet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 31
          },
          "line_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "line_after": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excel_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "minutes",
          "attendees"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 13
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "attendees": {
            "type": "string"
          },
          "skip_if": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample",
          "question",
          "reason"
        ],
        "properties": {
          "sample": {
            "$ref": "#/$defs/sample_id"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "intro",
        "facts",
        "done"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "done": {
          "type": "string"
        },
        "changeable": {
          "type": "string",
          "description": "最後のページで、回答の下に出す案内(あとから設定で変更できること)"
        }
      }
    }
  },
  "$defs": {
    "scalar": {
      "type": [
        "string",
        "number"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route",
        "label",
        "type",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "route": {
          "enum": [
            "form",
            "template",
            "onsite",
            "fixed"
          ]
        },
        "section": {
          "type": "string",
          "pattern": "^S[1-9][0-9]?$"
        },
        "theme": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "chapter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "short",
            "paragraph",
            "number",
            "radio",
            "checkbox",
            "dropdown",
            "datetime",
            "note",
            "table",
            "time",
            "rate",
            "dial"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "option_inputs": {
          "type": "object",
          "description": "選んだ選択肢の横に出す入力欄(キーは選択肢)",
          "additionalProperties": {"$ref": "#/$defs/item/properties/other"}
        },
        "other": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "short",
                "number"
              ]
            },
            "unit": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "unknown_option": {
          "type": "boolean",
          "description": "「未定」を付けるか"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "rate の単位(例: %・円)"
        },
        "option_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_to_on": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^S[1-9][0-9]?$"
          }
        },
        "show_if": {
          "$ref": "#/$defs/condition"
        },
        "unit": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "help": {
          "type": "array",
          "description": "ヘルプに出す、選び方や記入例(見出しと本文の組)",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text"],
            "properties": {
              "title": {"type": "string"},
              "text": {"type": "string"}
            }
          }
        },
        "body": {
          "type": "string"
        },
        "default": {},
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "message"
          ],
          "properties": {
            "kind": {
              "enum": [
                "regex",
                "integer",
                "number"
              ]
            },
            "pattern": {
              "type": "string",
              "format": "regex"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "regex"
              }
            }
          },
          "then": {
            "required": [
              "pattern"
            ]
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "column_show_if": {
          "type": "object",
          "description": "表の列ごとの表示条件(キーは列の番号。0から数える)",
          "patternProperties": {"^[0-9]+$": {"$ref": "#/$defs/condition"}},
          "additionalProperties": false
        },
        "optional_columns": {
          "type": "array",
          "description": "空欄のままでよい列の番号(0から数える)",
          "items": {"type": "integer", "minimum": 0}
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/scalar"
            }
          }
        },
        "onsite_note": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sample",
                "question"
              ],
              "properties": {
                "sample": {
                  "$ref": "#/$defs/sample_id"
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "doc"
              ],
              "properties": {
                "doc": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "merged_into": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "enum": [
                  "text",
                  "int",
                  "num",
                  "time"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "examples"
          ],
          "properties": {
            "format": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "route": {
                "const": "form"
              }
            }
          },
          "then": {
            "required": [
              "section"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "template"
              }
            }
          },
          "then": {
            "required": [
              "theme",
              "columns",
              "examples"
            ],
            "if": {
              "not": {
                "required": [
                  "merged_into"
                ]
              }
            },
            "then": {
              "required": [
                "cells",
                "line"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "onsite"
              }
            }
          },
          "then": {
            "required": [
              "onsite_note"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "default"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "radio",
                  "checkbox",
                  "dropdown"
                ]
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "columns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "form"
              },
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "cells"
            ]
          }
        }
      ]
    },
    "sample_id": {
      "enum": [
        "store",
        "pricing",
        "nomination",
        "tax",
        "payments",
        "products",
        "tables",
        "referral",
        "expenses",
        "register",
        "printer",
        "roster",
        "payroll"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item"
      ],
      "oneOf": [
        {"required": ["equals"]},
        {"required": ["in"]}
      ],
      "properties": {
        "item": {
          "type": "string"
        },
        "equals": {
          "$ref": "#/$defs/scalar"
        },
        "in": {
          "type": "array",
          "description": "どれかの答えのときに出す",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scalar"}
        }
      }
    }
  }
}
