{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(python3 scripts/*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(pip install -r requirements.txt)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pip install -q -r \"$CLAUDE_PROJECT_DIR/requirements.txt\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
